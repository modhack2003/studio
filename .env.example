# Copy to .env (local) or add these in Vercel → Project → Settings → Environment Variables.

# MongoDB Atlas connection string.
# - MUST include the database name after the host:  ...mongodb.net/<database>?...
# - Special characters in the password must be URL-encoded (@ → %40, : → %3A, / → %2F, # → %23)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority"

# First-login PIN (6–12 digits). After logging in you can set a new PIN in
# Admin → Security; it is stored hashed in the database and replaces this value.
ADMIN_PIN=""   # e.g. a random 8-digit number — not a birthday, not 123456

# Optional — GitHub sync works without a token (60 requests/hour); a read-only
# token raises the limit. GITHUB_USERNAME is only used if the profile has no GitHub URL.
GITHUB_TOKEN=""
GITHUB_USERNAME="modhack2003"

# Optional — needed only for uploading a resume PDF from the admin panel (Vercel → Storage → Blob).
BLOB_READ_WRITE_TOKEN=""
